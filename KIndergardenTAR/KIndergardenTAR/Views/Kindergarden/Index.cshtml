@model IEnumerable<KindergardenTAR.Models.Kindergarden.KindergardenIndexViewModel>

@{
    int rowNumber = 1;
}

<div>
    <a asp-action="create" asp-controller="Kindergarden" type="submit" class="btn btn-primary">Create</a>
</div>

<div class="h1">
    Kindergarden
</div>
<form method="get">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">GroupName</th>
                <th scope="col">ChildrenCount</th>
                <th scope="col">KindergartenName</th>
                <th scope="col">TeacherName</th>
                <th scope="col">CreatedAt</th>
                <th scope="col">UpdatedAt</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kindergarden in Model)
            {
                <tr>
                    <td>@rowNumber</td>
                    <td>@kindergarden.GroupName</td>
                    <td>@kindergarden.ChildrenCount</td>
                    <td>@kindergarden.KindergartenName</td>
                    <td>@kindergarden.TeacherName</td>
                    <td>@kindergarden.CreatedAt</td>
                    <td>@kindergarden.UpdatedAt</td>
                    <td>
                        <a asp-action="details" asp-controller="Kindergarden" asp-route-id="@kindergarden.Id" type="submit" class="btn btn-info">Details</a>
                        <a asp-action="update" asp-controller="Kindergarden" asp-route-id="@kindergarden.Id" type="submit" class="btn btn-success">Update</a>
                        <a asp-action="delete" asp-controller="Kindergarden" asp-route-id="@kindergarden.Id" type="submit" class="btn btn-danger">Delete</a>

                    </td>
                </tr>
                
                   rowNumber++;
                
            }
        </tbody>
    </table>
</form>