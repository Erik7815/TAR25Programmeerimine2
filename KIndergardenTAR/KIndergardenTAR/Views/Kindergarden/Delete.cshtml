@model KindergardenTAR.Models.Kindergarden.KindergardenDeleteViewModel

@{
    ViewData["Title"] = "Delete Kindergarden";
}

<dl class="row">
    <div>
        <label asp-for="GroupName" class="col-sm-2 col-form-label"></label>
        @Html.DisplayFor(Model => Model.GroupName)
    </div>
</dl>

<dl class="row">
    <div>
        <label asp-for="ChildrenCount" class="col-sm-2 col-form-label"></label>
        @Html.DisplayFor(model => model.ChildrenCount)
    </div>
</dl>

<dl class="row">
    <div>
        <label asp-for="KindergartenName" class="col-sm-2 col-form-label"></label>
        @Html.DisplayFor(model => model.KindergartenName)
    </div>
</dl>

<dl class="row">
    <div>
        <label asp-for="TeacherName" class="col-sm-2 col-form-label"></label>
        @Html.DisplayFor(model => model.TeacherName)
    </div>
</dl>

<dl class="row">
    <div>
        <label asp-for="GroupName" class="col-sm-2 col-form-label"></label>
        @Html.DisplayFor(model => model.GroupName)
    </div>
</dl>
@foreach (var images in Model.Image)
{
    <partial name="_Images" model="images" />
    <br />}
<hr />


<form asp-action="DeletePost" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-danger" />

    <a asp-action="Index"
       asp-controller="Kindergarden" class="btn btn-secondary">
        Back to list
    </a>
</form>